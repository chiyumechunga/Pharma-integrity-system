{
  "name": "pharma",
  "version": "1.0",
  "description": "Pharma Integrity Ledger - custody via participant_id UUIDs",
  "methods": [
    {
      "name": "CreateAsset",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "productId","schema":{"type":"string"}},
        {"name": "productName","schema":{"type":"string"}},
        {"name": "manufacturerId","schema":{"type":"string"}},
        {"name": "manufacturingDate","schema":{"type":"string"}},
        {"name": "expiryDate","schema":{"type":"string"}}
      ],
      "returns": [{"name":"asset","schema":{"type":"object"}}]
    },
    {
      "name": "TransferCustody",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "fromParticipantId","schema":{"type":"string"}},
        {"name": "toParticipantId","schema":{"type":"string"}},
        {"name": "eventType","schema":{"type":"string"}},
        {"name": "quantity","schema":{"type":"integer"}}
      ],
      "returns": [{"name":"asset","schema":{"type":"object"}}]
    },
    {
      "name": "SubmitTestResult",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "inspectorId","schema":{"type":"string"}},
        {"name": "testResult","schema":{"type":"string"}},
        {"name": "labNotes","schema":{"type":"string"}}
      ],
      "returns": [{"name":"asset","schema":{"type":"object"}}]
    },
    {
      "name": "RecallBatch",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "regulatorUuid","schema":{"type":"string"}},
        {"name": "recallReason","schema":{"type":"string"}}
      ],
      "returns": [{"name":"asset","schema":{"type":"object"}}]
    },
    {
      "name": "DispenseBatch",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "pharmacyParticipantId","schema":{"type":"string"}},
        {"name": "patientParticipantId","schema":{"type":"string"}},
        {"name": "quantity","schema":{"type":"integer"}}
      ],
      "returns": [{"name":"asset","schema":{"type":"object"}}]
    },
    {
      "name": "ReadAsset",
      "params": [{"name": "batchNumber","schema":{"type":"string"}}],
      "returns": [{"name":"asset","schema":{"type":"object"}}]
    },
    {
      "name": "AssetExists",
      "params": [{"name": "batchNumber","schema":{"type":"string"}}],
      "returns": [{"name":"exists","schema":{"type":"boolean"}}]
    },
    {
      "name": "GetAssetHistory",
      "params": [{"name": "batchNumber","schema":{"type":"string"}}],
      "returns": [{"name":"history","schema":{"type":"string"}}]
    }
  ],
  "events": [
    {
      "name": "AssetCreated",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "productId","schema":{"type":"string"}},
        {"name": "productName","schema":{"type":"string"}},
        {"name": "manufacturerId","schema":{"type":"string"}},
        {"name": "manufacturingDate","schema":{"type":"string"}},
        {"name": "expiryDate","schema":{"type":"string"}}
      ]
    },
    {
      "name": "CustodyTransferred",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "fromParticipantId","schema":{"type":"string"}},
        {"name": "toParticipantId","schema":{"type":"string"}},
        {"name": "eventType","schema":{"type":"string"}},
        {"name": "quantity","schema":{"type":"integer"}}
      ]
    },
    {
      "name": "TestResultSubmitted",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "inspectorId","schema":{"type":"string"}},
        {"name": "testResult","schema":{"type":"string"}},
        {"name": "labNotes","schema":{"type":"string"}}
      ]
    },
    {
      "name": "DrugRecalled",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "recalledByUuid","schema":{"type":"string"}},
        {"name": "recallReason","schema":{"type":"string"}}
      ]
    },
    {
      "name": "DrugDispensed",
      "params": [
        {"name": "batchNumber","schema":{"type":"string"}},
        {"name": "pharmacyParticipantId","schema":{"type":"string"}},
        {"name": "patientParticipantId","schema":{"type":"string"}},
        {"name": "quantity","schema":{"type":"integer"}}
      ]
    }
  ]
}